ENVIRONMENT=development
GATEWAY_CONFIG=config/gateway.yaml
PRICING_CONFIG=config/pricing.yaml

# SQLite for local runs; compose uses PostgreSQL (postgresql:// and postgres:// are normalised).
DATABASE_URL=sqlite+aiosqlite:///./gateway.db
# Optional: shared cache and rate-limit counters across replicas.
REDIS_URL=

# Protects /admin/*. Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=change-me-admin
# Optional fixed virtual key created at startup (demo / local development only).
DEMO_API_KEY=sk-gw-demo-local-key-0001
DEMO_KEY_BUDGET_USD=5

# Real providers (all optional; without them the fake providers serve the demo aliases).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=

LOG_LEVEL=INFO
LOG_JSON=true
LOG_REDACT_PII=true
LOG_PAYLOADS=false

BUDGET_ALERT_THRESHOLDS=0.5,0.8,1.0
BUDGET_WEBHOOK_URL=

PORT=8080
